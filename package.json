        "@types/qs": "^6.14.0",
        "@types/uuid": "^10.0.0",
        "aws-cdk-lib": "^2.202.0",
        "electrodb": "^3.4.3",
        "jest": "^30.0.2",
        "standard-version": "^9.5.0",
        "ts-jest": "^29.4.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "@aws-cdk/aws-amplify-alpha": "^2.202.0-alpha.0",
        "@aws-sdk/client-cloudwatch-logs": "^3.832.0",
        "@aws-sdk/client-cognito-identity": "^3.830.0",
        "@aws-sdk/client-cognito-identity-provider": "^3.830.0",
