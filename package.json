        "@types/cookie": "^0.6.0",
        "constructs": "^10.4.2",
        "cookie": "^1.0.2",
        "esbuild": "^0.25.5",
        "meilisearch": "^0.51.0",
        "path-to-regexp": "^8.2.0",
        "qs": "^6.14.0",
        "source-map-support": "^0.5.21",
        "tslog": "^4.9.3"
    },
    "peerDependencies": {
        "aws-cdk-lib": "^2.202.0",
        "electrodb": "^3.4.3"
    }
